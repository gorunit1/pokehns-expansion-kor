+// HNS9784-TRACE (scratch only, never committed): print every recorded battle event.
+static void HnsTrace_Message(const u8 *s)
+{
+    static const char hex[] = "0123456789ABCDEF";
+    char buf[121];
+    u32 n = 0;
+    bool32 first = TRUE;
+    while (TRUE)
+    {
+        u8 c = *s++;
+        if (c != EOS)
+        {
+            buf[n++] = hex[c >> 4];
+            buf[n++] = hex[c & 0xF];
+        }
+        if (c == EOS || n >= 120)
+        {
+            buf[n] = '\0';
+            Test_MgbaPrintf(first ? "TR:M %s" : "TR:M+ %s", buf);
+            first = FALSE;
+            n = 0;
+            if (c == EOS)
+                break;
+        }
+    }
+}
